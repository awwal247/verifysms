DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=1
ALLOWED_HOSTS=

# Leave DATABASE_URL empty to use local SQLite. Set it to your Supabase
# connection string (Project Settings -> Database -> Connection string ->
# URI) to use Supabase Postgres instead. Use the pooler URL (port 6543) in
# production/serverless; the direct connection (port 5432) is fine locally.
DATABASE_URL=
DB_SSL_REQUIRE=1
FIVESIM_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
SITE_URL=
