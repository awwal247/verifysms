# ── Required in production ────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app REFUSES TO START without this unless DJANGO_DEBUG=1.
DJANGO_SECRET_KEY=
# Must be 0/unset in production. Use 1 only on your own machine.
DJANGO_DEBUG=0
# Comma-separated hostnames. "*" is ignored in production. If empty, the host of SITE_URL
# (plus its www/apex twin and Vercel's VERCEL_URL hostnames) is allowed automatically.
ALLOWED_HOSTS=127.0.0.1,localhost
# Public URL. An https:// value switches on secure cookies, HTTPS redirect and HSTS.
SITE_URL=http://127.0.0.1:8000

# ── Database ──────────────────────────────────────────────────────────────
# Leave empty to use local SQLite. Use the Supabase pooler URL in production.
DATABASE_URL=
DB_SSL_REQUIRE=1

# ── Providers / payments (prefer env vars or the admin UI - never commit values) ──
SMSBUS_API_KEY=
FIVESIM_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Security tuning (all optional) ────────────────────────────────────────
# HSTS starts at 1 day. After confirming everything works over HTTPS raise to 31536000.
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# 1 = send CSP as Report-Only (observe without blocking) while testing a change.
CSP_REPORT_ONLY=0
CSP_REPORT_URI=
# Researcher contact for /.well-known/security.txt, e.g. mailto:security@yourdomain.com
SECURITY_CONTACT=
# Shared cache so login throttling is global across serverless instances (add `redis>=5` to requirements.txt).
REDIS_URL=
# Leave unset. Set temporarily only to run /deploy-setup/?token=... once, then remove it.
DEPLOY_SETUP_TOKEN=
